# firedrill-gate: the Switch agent, the verify runner and the telemetry feed (:8787).
# gate/verify.py runs checks as local pytest subprocesses against incident-lab/, so the image
# carries the lab's dependencies (pytest included). git is for the evidence remote.
FROM python:3.12-slim
RUN apt-get update \
 && apt-get install -y --no-install-recommends git \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY gate/requirements.txt gate/requirements.txt
COPY incident-lab/requirements.txt incident-lab/requirements.txt
RUN pip install --no-cache-dir -r gate/requirements.txt -r incident-lab/requirements.txt
COPY gate gate
COPY incident-lab incident-lab
ENV PYTHONUNBUFFERED=1
EXPOSE 8787
CMD ["python", "-m", "gate.main"]
