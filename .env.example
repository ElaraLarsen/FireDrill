# ── Switch standalone stack (keys from Switch's own .env.example, v0.31.0) ──
# scripts/bootstrap_stack.sh fills the empty secrets.
SWITCH_REGISTRY=ghcr.io
SWITCH_IMAGE_NAMESPACE=sandbox-quantum
SWITCH_VERSION=0.31.0
GATEWAY_HOST_PORT=3000
API_HOST_PORT=8000
MATTERMOST_HOST_PORT=8065
POSTGRES_HOST_PORT=5432
SWITCH_BIND_ADDR=127.0.0.1
DB_HOST=localhost
DB_PORT=5432
DB_USER=switch_app
DB_PASSWORD=
DB_OWNER_USER=postgres
DB_OWNER_PASSWORD=
DB_NAME=switch
TELEMETRY_ENVIRONMENT=local
ID_SERVER_NAME=localhost
AGENT_REGISTRATION_TOKEN=
CONTROLLER_TOKEN_SECRET=
FEATURE_FLAGS_ENABLED=
SECRET_KEYS=
JWT_SECRET_KEY=
GATEWAY_ADMIN_EMAIL=admin@switch.local
GATEWAY_ADMIN_PASSWORD=
FRONTEND_BASE_URL=http://localhost:3000
MATTERMOST_ADMIN_USER=admin
MATTERMOST_ADMIN_PASSWORD=
MATTERMOST_TEAM_NAME=switch
MATTERMOST_USER=user
MATTERMOST_USER_PASSWORD=
OUTBOUND_ALLOWED_PRIVATE_HOSTS=localhost

# ── FireDrill gate ──
# Agent bridge base URL (GET /health must answer 200 here).
SWITCH_URL=http://localhost:8000
# Personal registration key: Gateway -> API Keys, minted by the person who runs the template.
FIREDRILL_REGISTRATION_TOKEN=
# Written by scripts/register_gate.py.
FIREDRILL_GATE_AGENT_ID=
FIREDRILL_GATE_API_KEY=
# Written by scripts/bootstrap_evidence.sh. Only the gate process may hold the key.
FIREDRILL_GATE_KEY=
FIREDRILL_EVIDENCE_REMOTE=/tmp/firedrill/evidence.git
FIREDRILL_KEYHASH_FILE=/tmp/firedrill/gate.keyhash
# Names exactly as Switch reports them in `sender_name` (agents) / chat username (people).
FIREDRILL_GATE_NAME=firedrill-gate
FIREDRILL_FIXER_NAME=firedrill-fixer
FIREDRILL_BREAKER_NAME=firedrill-breaker
# Comma-separated people allowed to APPROVE. Default: the seeded Mattermost user.
FIREDRILL_APPROVERS=user
FIREDRILL_VERIFY_CMD=python3 -m gate.verify
FIREDRILL_VERIFY_TIMEOUT_S=900
